DASHSCOPE_API_KEY=
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_TIMEOUT=10

USE_LOCAL_MODEL=true
LOCAL_MODEL_NAME=qwen2.5:7b
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MAX_LENGTH=256

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag_medical

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DIM=384
MILVUS_METRIC=IP
MILVUS_INDEX=IVF_FLAT
MILVUS_NLIST=1024
MILVUS_NPROBE=32

COLLECTION_MEDICAL_QA=medical_qa_demo
COLLECTION_SCENARIO_MEMORY=scenario_memory_vectors
COLLECTION_SEMANTIC_MEMORY=semantic_memory_vectors
# Set both values together after verifying the v2 collection and its matching
# SQLite index. Leave this path empty for the legacy collection.
MEDICAL_BM25_SQLITE_PATH=
HYBRID_CHANNEL_TOP_K=100
HYBRID_RERANK_CANDIDATES=20

# A reverse proxy may send X-Authenticated-User-Id plus this HMAC signature.
# Do not allow client body/query user_id values in production.
AUTH_PROXY_SHARED_SECRET=
# Local Streamlit demo only. Keep false behind a signed authentication proxy.
ALLOW_UNTRUSTED_USER_ID=true

# Startup seed switches. Vector construction can take several minutes on CPU.
INIT_KNOWLEDGE_GRAPH=true
INIT_VECTOR_DATA=true
COLLECTION_MEDICAL_QA_BUILD=medical_qa_demo
KG_IMPORT_LIMIT=200
VECTOR_IMPORT_LIMIT=2000

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

REDIS_URL=redis://localhost:6379/0
